# API
PORT=8787

# Casper integration.
# Default mode is mock so the app runs without secrets.
CASPER_MODE=mock
CASPER_RPC_URL=https://node.testnet.casper.network/rpc
CASPER_CHAIN_NAME=casper-test
CASPER_KEY_ALGORITHM=ED25519

# Use one of these only for real testnet transactions.
# Never commit a funded private key.
CASPER_PRIVATE_KEY_HEX=
CASPER_PRIVATE_KEY_PEM=
CASPER_PRIVATE_KEY_PEM_FILE=

# Native transfer fallback settings.
CASPER_TRANSFER_AMOUNT_MOTES=2500000000
CASPER_PAYMENT_MOTES=100000000
CASPER_EXPLORER_BASE_URL=https://testnet.cspr.live/transaction

# Finals contract-registry settings. These hashes are public Testnet identifiers.
# If CASPER_MODE=real, the server can call record_credential and record_execution_intent.
CASPER_RISK_REGISTRY_HASH=e5c63c54f0c147703548976c174087d4a8e087da191adc2f466fa101e1154a3a
CASPER_RISK_REGISTRY_PACKAGE_HASH=aacf4a08413e873bb3f67b2d7ce78230e3d3e2bde558c2203bd55b1a37853345
CASPER_CONTRACT_CALL_PAYMENT_MOTES=20000000000
CASPER_REGISTRY_WAIT_MS=180000
